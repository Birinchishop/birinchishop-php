{
    "name": "birinchishop/birinchishop",
    "description": "Official PHP client for the Birinchi Shop Partner API (CPA affiliate network, Uzbekistan): offers, tracking links, orders, stats, events, webhooks, Meta ads.",
    "type": "library",
    "license": "MIT",
    "keywords": ["birinchishop", "cpa", "affiliate", "affiliate-network", "partner-api", "uzbekistan", "cod", "postback", "webhook", "keitaro", "binom", "sdk"],
    "homepage": "https://birinchishop.uz/api/v1/docs",
    "authors": [
        {
            "name": "Birinchi Shop",
            "email": "noreply@birinchishop.uz",
            "homepage": "https://birinchishop.uz"
        }
    ],
    "support": {
        "docs": "https://birinchishop.uz/api/v1/docs",
        "issues": "https://github.com/Birinchishop/birinchishop-php/issues",
        "source": "https://github.com/Birinchishop/birinchishop-php"
    },
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "Birinchishop\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Birinchishop\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "php tests/run.php",
        "test:phpunit": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
